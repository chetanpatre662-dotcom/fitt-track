# ===== FitTrack AI Backend Environment =====
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.

# --- Server ---
PORT=8080
NODE_ENV=development
# Comma-separated list of allowed CORS origins (Flutter web/dev tools). Mobile app does not need CORS.
CORS_ORIGINS=http://localhost:3000

# --- Firebase Admin SDK ---
# Option A (recommended for local dev): path to a service account JSON file.
#   Download from Firebase Console > Project Settings > Service Accounts > Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Option B (recommended for production / CI): inline credentials via env vars.
#   If these three are set they take precedence over GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=fittness-ba0ac
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes; the backend converts them to real newlines.
FIREBASE_PRIVATE_KEY=
# Storage bucket, e.g. your-project-id.appspot.com
FIREBASE_STORAGE_BUCKET=fittness-ba0ac.firebasestorage.app

# --- Gemini (Google Generative AI) ---
# Get a key from https://aistudio.google.com/app/apikey
GCP_API_KEY=your-gcp-api-key-here
# Use a current, non-deprecated model.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash-lite

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=15

# --- Logging ---
LOG_LEVEL=info
